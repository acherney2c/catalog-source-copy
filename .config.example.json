      "staticFields": {
        "objecttype": "product"
      }
    },
    "availability": {
      "fieldMapping": {},
      "excludeFields": [],
      "includeAllFields": true,
      "documentIdField": "documentId",
      "titleField": "title",
      "staticFields": {
        "objecttype": "availability"
      }
    }
  }
